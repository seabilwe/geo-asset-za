# Copy to .env and change every value. .env is ignored by git; never commit real passwords.

# superuser of the database container (used only by bootstrap, migrations, backups and the scheduler)
POSTGRES_PASSWORD=change-me

# password for all demonstration login roles (manager_demo, inspector_a, web_app, ...)
# set GAZ_PASSWORD_<LOGIN> (for example GAZ_PASSWORD_WEB_APP) to give one role its own password
GAZ_DEMO_PASSWORD=change-me-too

# pgAdmin (only with: docker compose --profile admin up -d pgadmin)
PGADMIN_EMAIL=admin@example.org
PGADMIN_PASSWORD=change-me-three
