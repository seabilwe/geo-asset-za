  }
  subgraph cluster_maintenance { label=<<b>maintenance</b>>; fontsize=13; style="rounded"; color="#B9A383"; 
    "maintenance.inspections" [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="3"><tr><td bgcolor="#F0DCC8" colspan="2" align="left"><b>inspections</b></td></tr><tr><td align="left" port="inspection_id">PK <b>inspection_id</b></td><td align="left"><font color="#6B5B4B">bigint</font></td></tr><tr><td align="left" port="asset_id">FK asset_id</td><td align="left"><font color="#6B5B4B">bigint</font></td></tr><tr><td align="left" port="inspected_on">inspected_on</td><td align="left"><font color="#6B5B4B">date</font></td></tr><tr><td align="left" port="condition_grade">FK condition_grade</td><td align="left"><font color="#6B5B4B">smallint</font></td></tr><tr><td align="left" port="defect_code">FK defect_code</td><td align="left"><font color="#6B5B4B">varchar(20)</font></td></tr><tr><td align="left" port="action_required">action_required</td><td align="left"><font color="#6B5B4B">boolean</font></td></tr><tr><td align="left" port="inspector">inspector</td><td align="left"><font color="#6B5B4B">name</font></td></tr><tr><td align="left" port="notes">notes</td><td align="left"><font color="#6B5B4B">text</font></td></tr><tr><td align="left" port="created_at">created_at</td><td align="left"><font color="#6B5B4B">timestamptz</font></td></tr></table>>];
    "maintenance.maintenance_activities" [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="3"><tr><td bgcolor="#F0DCC8" colspan="2" align="left"><b>maintenance_activities</b></td></tr><tr><td align="left" port="activity_id">PK <b>activity_id</b></td><td align="left"><font color="#6B5B4B">bigint</font></td></tr><tr><td align="left" port="work_order_id">FK work_order_id</td><td align="left"><font color="#6B5B4B">bigint</font></td></tr><tr><td align="left" port="activity_type">activity_type</td><td align="left"><font color="#6B5B4B">varchar(40)</font></td></tr><tr><td align="left" port="performed_on">performed_on</td><td align="left"><font color="#6B5B4B">date</font></td></tr><tr><td align="left" port="labour_hours">labour_hours</td><td align="left"><font color="#6B5B4B">numeric(6,2)</font></td></tr><tr><td align="left" port="crew">crew</td><td align="left"><font color="#6B5B4B">varchar(60)</font></td></tr><tr><td align="left" port="notes">notes</td><td align="left"><font color="#6B5B4B">text</font></td></tr></table>>];
    "maintenance.maintenance_costs" [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="3"><tr><td bgcolor="#F0DCC8" colspan="2" align="left"><b>maintenance_costs</b></td></tr><tr><td align="left" port="cost_id">PK <b>cost_id</b></td><td align="left"><font color="#6B5B4B">bigint</font></td></tr><tr><td align="left" port="work_order_id">FK work_order_id</td><td align="left"><font color="#6B5B4B">bigint</font></td></tr><tr><td align="left" port="cost_type">cost_type</td><td align="left"><font color="#6B5B4B">varchar(12)</font></td></tr><tr><td align="left" port="cost_status">cost_status</td><td align="left"><font color="#6B5B4B">varchar(8)</font></td></tr><tr><td align="left" port="amount_zar">amount_zar</td><td align="left"><font color="#6B5B4B">numeric(12,2)</font></td></tr><tr><td align="left" port="cost_date">cost_date</td><td align="left"><font color="#6B5B4B">date</font></td></tr></table>>];
    "maintenance.work_orders" [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="3"><tr><td bgcolor="#F0DCC8" colspan="2" align="left"><b>work_orders</b></td></tr><tr><td align="left" port="work_order_id">PK <b>work_order_id</b></td><td align="left"><font color="#6B5B4B">bigint</font></td></tr><tr><td align="left" port="wo_number">wo_number</td><td align="left"><font color="#6B5B4B">varchar(20)</font></td></tr><tr><td align="left" port="asset_id">FK asset_id</td><td align="left"><font color="#6B5B4B">bigint</font></td></tr><tr><td align="left" port="inspection_id">FK inspection_id</td><td align="left"><font color="#6B5B4B">bigint</font></td></tr><tr><td align="left" port="wo_type">wo_type</td><td align="left"><font color="#6B5B4B">varchar(12)</font></td></tr><tr><td align="left" port="priority_code">FK priority_code</td><td align="left"><font color="#6B5B4B">varchar(2)</font></td></tr><tr><td align="left" port="status">status</td><td align="left"><font color="#6B5B4B">varchar(12)</font></td></tr><tr><td align="left" port="raised_on">raised_on</td><td align="left"><font color="#6B5B4B">date</font></td></tr><tr><td align="left" port="target_date">target_date</td><td align="left"><font color="#6B5B4B">date</font></td></tr><tr><td align="left" port="completed_on">completed_on</td><td align="left"><font color="#6B5B4B">date</font></td></tr><tr><td align="left" port="description">description</td><td align="left"><font color="#6B5B4B">text</font></td></tr><tr><td align="left" port="created_at">created_at</td><td align="left"><font color="#6B5B4B">timestamptz</font></td></tr></table>>];
