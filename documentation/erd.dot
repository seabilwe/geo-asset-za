digraph erd {
  graph [rankdir=LR, fontname="Helvetica", fontsize=11, nodesep=0.4, ranksep=1.2, pad=0.3, bgcolor="white", splines=true, newrank=true];
  node [shape=plain, fontname="Helvetica", fontsize=9];
  edge [color="#5A4A3C", penwidth=1.0, dir=both, arrowsize=0.9];
  subgraph cluster_reference { label=<<b>reference</b>>; fontsize=13; style="rounded"; color="#B9A383"; margin=14;
    "reference.asset_classes" [label=<<table border="1" cellborder="1" cellspacing="0" cellpadding="3" color="#5A4A3C"><tr><td bgcolor="#E6DDC8" align="left"><b>asset_classes</b></td></tr><tr><td port="class_code" align="left" balign="left" bgcolor="white"><table border="0" cellspacing="0" cellpadding="0"><tr><td align="left" width="34"><font color="#7A4B26">PK</font></td><td align="left" width="128"><b>class_code</b></td><td align="left" width="96"><font color="#6B5B4B">varchar(10)</font></td></tr></table></td></tr><tr><td port="class_name" align="left" balign="left" bgcolor="white"><table border="0" cellspacing="0" cellpadding="0"><tr><td align="left" width="34"> </td><td align="left" width="128">class_name</td><td align="left" width="96"><font color="#6B5B4B">varchar(80)</font></td></tr></table></td></tr><tr><td port="department" align="left" balign="left" bgcolor="white"><table border="0" cellspacing="0" cellpadding="0"><tr><td align="left" width="34"> </td><td align="left" width="128">department</td><td align="left" width="96"><font color="#6B5B4B">varchar(120)</font></td></tr></table></td></tr><tr><td port="sort_order" align="left" balign="left" bgcolor="white"><table border="0" cellspacing="0" cellpadding="0"><tr><td align="left" width="34"> </td><td align="left" width="128">sort_order</td><td align="left" width="96"><font color="#6B5B4B">smallint</font></td></tr></table></td></tr></table>>];
    "reference.asset_statuses" [label=<<table border="1" cellborder="1" cellspacing="0" cellpadding="3" color="#5A4A3C"><tr><td bgcolor="#E6DDC8" align="left"><b>asset_statuses</b></td></tr><tr><td port="status_code" align="left" balign="left" bgcolor="white"><table border="0" cellspacing="0" cellpadding="0"><tr><td align="left" width="34"><font color="#7A4B26">PK</font></td><td align="left" width="128"><b>status_code</b></td><td align="left" width="96"><font color="#6B5B4B">varchar(20)</font></td></tr></table></td></tr><tr><td port="label" align="left" balign="left" bgcolor="white"><table border="0" cellspacing="0" cellpadding="0"><tr><td align="left" width="34"> </td><td align="left" width="128">label</td><td align="left" width="96"><font color="#6B5B4B">varchar(40)</font></td></tr></table></td></tr><tr><td port="is_in_service" align="left" balign="left" bgcolor="white"><table border="0" cellspacing="0" cellpadding="0"><tr><td align="left" width="34"> </td><td align="left" width="128">is_in_service</td><td align="left" width="96"><font color="#6B5B4B">boolean</font></td></tr></table></td></tr></table>>];
    "reference.asset_types" [label=<<table border="1" cellborder="1" cellspacing="0" cellpadding="3" color="#5A4A3C"><tr><td bgcolor="#E6DDC8" align="left"><b>asset_types</b></td></tr><tr><td port="type_code" align="left" balign="left" bgcolor="white"><table border="0" cellspacing="0" cellpadding="0"><tr><td align="left" width="34"><font color="#7A4B26">PK</font></td><td align="left" width="128"><b>type_code</b></td><td align="left" width="96"><font color="#6B5B4B">varchar(30)</font></td></tr></table></td></tr><tr><td port="type_name" align="left" balign="left" bgcolor="white"><table border="0" cellspacing="0" cellpadding="0"><tr><td align="left" width="34"> </td><td align="left" width="128">type_name</td><td align="left" width="96"><font color="#6B5B4B">varchar(80)</font></td></tr></table></td></tr><tr><td port="class_code" align="left" balign="left" bgcolor="white"><table border="0" cellspacing="0" cellpadding="0"><tr><td align="left" width="34"><font color="#7A4B26">FK</font></td><td align="left" width="128">class_code</td><td align="left" width="96"><font color="#6B5B4B">varchar(10)</font></td></tr></table></td></tr><tr><td port="geom_type" align="left" balign="left" bgcolor="white"><table border="0" cellspacing="0" cellpadding="0"><tr><td align="left" width="34"> </td><td align="left" width="128">geom_type</td><td align="left" width="96"><font color="#6B5B4B">varchar(15)</font></td></tr></table></td></tr><tr><td port="detail_table" align="left" balign="left" bgcolor="white"><table border="0" cellspacing="0" cellpadding="0"><tr><td align="left" width="34"> </td><td align="left" width="128">detail_table</td><td align="left" width="96"><font color="#6B5B4B">varchar(63)</font></td></tr></table></td></tr><tr><td port="design_life_years" align="left" balign="left" bgcolor="white"><table border="0" cellspacing="0" cellpadding="0"><tr><td align="left" width="34"> </td><td align="left" width="128">design_life_years</td><td align="left" width="96"><font color="#6B5B4B">smallint</font></td></tr></table></td></tr><tr><td port="inspection_interval_months" align="left" balign="left" bgcolor="white"><table border="0" cellspacing="0" cellpadding="0"><tr><td align="left" width="34"> </td><td align="left" width="128">inspection_interval_months</td><td align="left" width="96"><font color="#6B5B4B">smallint</font></td></tr></table></td></tr><tr><td port="criticality" align="left" balign="left" bgcolor="white"><table border="0" cellspacing="0" cellpadding="0"><tr><td align="left" width="34"> </td><td align="left" width="128">criticality</td><td align="left" width="96"><font color="#6B5B4B">smallint</font></td></tr></table></td></tr><tr><td port="replacement_unit_cost_zar" align="left" balign="left" bgcolor="white"><table border="0" cellspacing="0" cellpadding="0"><tr><td align="left" width="34"> </td><td align="left" width="128">replacement_unit_cost_zar</td><td align="left" width="96"><font color="#6B5B4B">numeric(12,2)</font></td></tr></table></td></tr><tr><td port="cost_unit" align="left" balign="left" bgcolor="white"><table border="0" cellspacing="0" cellpadding="0"><tr><td align="left" width="34"> </td><td align="left" width="128">cost_unit</td><td align="left" width="96"><font color="#6B5B4B">varchar(10)</font></td></tr></table></td></tr><tr><td port="code_prefix" align="left" balign="left" bgcolor="white"><table border="0" cellspacing="0" cellpadding="0"><tr><td align="left" width="34"> </td><td align="left" width="128">code_prefix</td><td align="left" width="96"><font color="#6B5B4B">varchar(6)</font></td></tr></table></td></tr></table>>];
    "reference.condition_grades" [label=<<table border="1" cellborder="1" cellspacing="0" cellpadding="3" color="#5A4A3C"><tr><td bgcolor="#E6DDC8" align="left"><b>condition_grades</b></td></tr><tr><td port="grade" align="left" balign="left" bgcolor="white"><table border="0" cellspacing="0" cellpadding="0"><tr><td align="left" width="34"><font color="#7A4B26">PK</font></td><td align="left" width="128"><b>grade</b></td><td align="left" width="96"><font color="#6B5B4B">smallint</font></td></tr></table></td></tr><tr><td port="label" align="left" balign="left" bgcolor="white"><table border="0" cellspacing="0" cellpadding="0"><tr><td align="left" width="34"> </td><td align="left" width="128">label</td><td align="left" width="96"><font color="#6B5B4B">varchar(20)</font></td></tr></table></td></tr><tr><td port="description" align="left" balign="left" bgcolor="white"><table border="0" cellspacing="0" cellpadding="0"><tr><td align="left" width="34"> </td><td align="left" width="128">description</td><td align="left" width="96"><font color="#6B5B4B">text</font></td></tr></table></td></tr><tr><td port="colour_hex" align="left" balign="left" bgcolor="white"><table border="0" cellspacing="0" cellpadding="0"><tr><td align="left" width="34"> </td><td align="left" width="128">colour_hex</td><td align="left" width="96"><font color="#6B5B4B">character(7)</font></td></tr></table></td></tr></table>>];
    "reference.data_sources" [label=<<table border="1" cellborder="1" cellspacing="0" cellpadding="3" color="#5A4A3C"><tr><td bgcolor="#E6DDC8" align="left"><b>data_sources</b></td></tr><tr><td port="source_code" align="left" balign="left" bgcolor="white"><table border="0" cellspacing="0" cellpadding="0"><tr><td align="left" width="34"><font color="#7A4B26">PK</font></td><td align="left" width="128"><b>source_code</b></td><td align="left" width="96"><font color="#6B5B4B">varchar(20)</font></td></tr></table></td></tr><tr><td port="source_name" align="left" balign="left" bgcolor="white"><table border="0" cellspacing="0" cellpadding="0"><tr><td align="left" width="34"> </td><td align="left" width="128">source_name</td><td align="left" width="96"><font color="#6B5B4B">varchar(120)</font></td></tr></table></td></tr><tr><td port="licence" align="left" balign="left" bgcolor="white"><table border="0" cellspacing="0" cellpadding="0"><tr><td align="left" width="34"> </td><td align="left" width="128">licence</td><td align="left" width="96"><font color="#6B5B4B">varchar(120)</font></td></tr></table></td></tr><tr><td port="url" align="left" balign="left" bgcolor="white"><table border="0" cellspacing="0" cellpadding="0"><tr><td align="left" width="34"> </td><td align="left" width="128">url</td><td align="left" width="96"><font color="#6B5B4B">varchar(255)</font></td></tr></table></td></tr><tr><td port="is_synthetic" align="left" balign="left" bgcolor="white"><table border="0" cellspacing="0" cellpadding="0"><tr><td align="left" width="34"> </td><td align="left" width="128">is_synthetic</td><td align="left" width="96"><font color="#6B5B4B">boolean</font></td></tr></table></td></tr></table>>];
    "reference.defect_types" [label=<<table border="1" cellborder="1" cellspacing="0" cellpadding="3" color="#5A4A3C"><tr><td bgcolor="#E6DDC8" align="left"><b>defect_types</b></td></tr><tr><td port="defect_code" align="left" balign="left" bgcolor="white"><table border="0" cellspacing="0" cellpadding="0"><tr><td align="left" width="34"><font color="#7A4B26">PK</font></td><td align="left" width="128"><b>defect_code</b></td><td align="left" width="96"><font color="#6B5B4B">varchar(20)</font></td></tr></table></td></tr><tr><td port="class_code" align="left" balign="left" bgcolor="white"><table border="0" cellspacing="0" cellpadding="0"><tr><td align="left" width="34"><font color="#7A4B26">FK</font></td><td align="left" width="128">class_code</td><td align="left" width="96"><font color="#6B5B4B">varchar(10)</font></td></tr></table></td></tr><tr><td port="label" align="left" balign="left" bgcolor="white"><table border="0" cellspacing="0" cellpadding="0"><tr><td align="left" width="34"> </td><td align="left" width="128">label</td><td align="left" width="96"><font color="#6B5B4B">varchar(80)</font></td></tr></table></td></tr></table>>];
    "reference.municipalities" [label=<<table border="1" cellborder="1" cellspacing="0" cellpadding="3" color="#5A4A3C"><tr><td bgcolor="#E6DDC8" align="left"><b>municipalities</b></td></tr><tr><td port="municipality_code" align="left" balign="left" bgcolor="white"><table border="0" cellspacing="0" cellpadding="0"><tr><td align="left" width="34"><font color="#7A4B26">PK</font></td><td align="left" width="128"><b>municipality_code</b></td><td align="left" width="96"><font color="#6B5B4B">varchar(10)</font></td></tr></table></td></tr><tr><td port="municipality_name" align="left" balign="left" bgcolor="white"><table border="0" cellspacing="0" cellpadding="0"><tr><td align="left" width="34"> </td><td align="left" width="128">municipality_name</td><td align="left" width="96"><font color="#6B5B4B">varchar(120)</font></td></tr></table></td></tr><tr><td port="province" align="left" balign="left" bgcolor="white"><table border="0" cellspacing="0" cellpadding="0"><tr><td align="left" width="34"> </td><td align="left" width="128">province</td><td align="left" width="96"><font color="#6B5B4B">varchar(60)</font></td></tr></table></td></tr><tr><td port="category" align="left" balign="left" bgcolor="white"><table border="0" cellspacing="0" cellpadding="0"><tr><td align="left" width="34"> </td><td align="left" width="128">category</td><td align="left" width="96"><font color="#6B5B4B">character(1)</font></td></tr></table></td></tr></table>>];
    "reference.wards" [label=<<table border="1" cellborder="1" cellspacing="0" cellpadding="3" color="#5A4A3C"><tr><td bgcolor="#E6DDC8" align="left"><b>wards</b></td></tr><tr><td port="ward_id" align="left" balign="left" bgcolor="white"><table border="0" cellspacing="0" cellpadding="0"><tr><td align="left" width="34"><font color="#7A4B26">PK</font></td><td align="left" width="128"><b>ward_id</b></td><td align="left" width="96"><font color="#6B5B4B">varchar(12)</font></td></tr></table></td></tr><tr><td port="municipality_code" align="left" balign="left" bgcolor="white"><table border="0" cellspacing="0" cellpadding="0"><tr><td align="left" width="34"><font color="#7A4B26">FK</font></td><td align="left" width="128">municipality_code</td><td align="left" width="96"><font color="#6B5B4B">varchar(10)</font></td></tr></table></td></tr><tr><td port="ward_no" align="left" balign="left" bgcolor="white"><table border="0" cellspacing="0" cellpadding="0"><tr><td align="left" width="34"> </td><td align="left" width="128">ward_no</td><td align="left" width="96"><font color="#6B5B4B">smallint</font></td></tr></table></td></tr><tr><td port="in_study_area" align="left" balign="left" bgcolor="white"><table border="0" cellspacing="0" cellpadding="0"><tr><td align="left" width="34"> </td><td align="left" width="128">in_study_area</td><td align="left" width="96"><font color="#6B5B4B">boolean</font></td></tr></table></td></tr><tr><td port="demarcation_year" align="left" balign="left" bgcolor="white"><table border="0" cellspacing="0" cellpadding="0"><tr><td align="left" width="34"> </td><td align="left" width="128">demarcation_year</td><td align="left" width="96"><font color="#6B5B4B">smallint</font></td></tr></table></td></tr><tr><td port="source_code" align="left" balign="left" bgcolor="white"><table border="0" cellspacing="0" cellpadding="0"><tr><td align="left" width="34"><font color="#7A4B26">FK</font></td><td align="left" width="128">source_code</td><td align="left" width="96"><font