digraph erd {
  graph [rankdir=LR, fontname="Helvetica", fontsize=11, nodesep=0.35, ranksep=1.1, pad=0.3, bgcolor="white"];
  node [shape=plaintext, fontname="Helvetica", fontsize=9];
  edge [color="#6B5B4B", arrowhead=crow, arrowtail=none, penwidth=0.9];
  subgraph cluster_reference { label=<<b>reference</b>>; fontsize=13; style="rounded"; color="#B9A383"; 
    "reference.asset_classes" [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="3"><tr><td bgcolor="#E6DDC8" colspan="2" align="left"><b>asset_classes</b></td></tr><tr><td align="left" port="class_code">PK <b>class_code</b></td><td align="left"><font color="#6B5B4B">varchar(10)</font></td></tr><tr><td align="left" port="class_name">class_name</td><td align="left"><font color="#6B5B4B">varchar(80)</font></td></tr><tr><td align="left" port="department">department</td><td align="left"><font color="#6B5B4B">varchar(120)</font></td></tr><tr><td align="left" port="sort_order">sort_order</td><td align="left"><font color="#6B5B4B">smallint</font></td></tr></table>>];
    "reference.asset_statuses" [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="3"><tr><td bgcolor="#E6DDC8" colspan="2" align="left"><b>asset_statuses</b></td></tr><tr><td align="left" port="status_code">PK <b>status_code</b></td><td align="left"><font color="#6B5B4B">varchar(20)</font></td></tr><tr><td align="left" port="label">label</td><td align="left"><font color="#6B5B4B">varchar(40)</font></td></tr><tr><td align="left" port="is_in_service">is_in_service</td><td align="left"><font color="#6B5B4B">boolean</font></td></tr></table>>];
    "reference.asset_types" [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="3"><tr><td bgcolor="#E6DDC8" colspan="2" align="left"><b>asset_types</b></td></tr><tr><td align="left" port="type_code">PK <b>type_code</b></td><td align="left"><font color="#6B5B4B">varchar(30)</font></td></tr><tr><td align="left" port="type_name">type_name</td><td align="left"><font color="#6B5B4B">varchar(80)</font></td></tr><tr><td align="left" port="class_code">FK class_code</td><td align="left"><font color="#6B5B4B">varchar(10)</font></td></tr><tr><td align="left" port="geom_type">geom_type</td><td align="left"><font color="#6B5B4B">varchar(15)</font></td></tr><tr><td align="left" port="detail_table">detail_table</td><td align="left"><font color="#6B5B4B">varchar(63)</font></td></tr><tr><td align="left" port="design_life_years">design_life_years</td><td align="left"><font color="#6B5B4B">smallint</font></td></tr><tr><td align="left" port="inspection_interval_months">inspection_interval_months</td><td align="left"><font color="#6B5B4B">smallint</font></td></tr><tr><td align="left" port="criticality">criticality</td><td align="left"><font color="#6B5B4B">smallint</font></td></tr><tr><td align="left" port="replacement_unit_cost_zar">replacement_unit_cost_zar</td><td align="left"><font color="#6B5B4B">numeric(12,2)</font></td></tr><tr><td align="left" port="cost_unit">cost_unit</td><td align="left"><font color="#6B5B4B">varchar(10)</font></td></tr><tr><td align="left" port="code_prefix">code_prefix</td><td align="left"><font color="#6B5B4B">varchar(6)</font></td></tr></table>>];
    "reference.condition_grades" [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="3"><tr><td bgcolor="#E6DDC8" colspan="2" align="left"><b>condition_grades</b></td></tr><tr><td align="left" port="grade">PK <b>grade</b></td><td align="left"><font color="#6B5B4B">smallint</font></td></tr><tr><td align="left" port="label">label</td><td align="left"><font color="#6B5B4B">varchar(20)</font></td></tr><tr><td align="left" port="description">description</td><td align="left"><font color="#6B5B4B">text</font></td></tr><tr><td align="left" port="colour_hex">colour_hex</td><td align="left"><font color="#6B5B4B">character(7)</font></td></tr></table>>];
    "reference.data_sources" [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="3"><tr><td bgcolor="#E6DDC8" colspan="2" align="left"><b>data_sources</b></td></tr><tr><td align="left" port="source_code">PK <b>source_code</b></td><td align="left"><font color="#6B5B4B">varchar(20)</font></td></tr><tr><td align="left" port="source_name">source_name</td><td align="left"><font color="#6B5B4B">varchar(120)</font></td></tr><tr><td align="left" port="licence">licence</td><td align="left"><font color="#6B5B4B">varchar(120)</font></td></tr><tr><td align="left" port="url">url</td><td align="left"><font color="#6B5B4B">varchar(255)</font></td></tr><tr><td align="left" port="is_synthetic">is_synthetic</td><td align="left"><font color="#6B5B4B">boolean</font></td></tr></table>>];
    "reference.defect_types" [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="3"><tr><td bgcolor="#E6DDC8" colspan="2" align="left"><b>defect_types</b></td></tr><tr><td align="left" port="defect_code">PK <b>defect_code</b></td><td align="left"><font color="#6B5B4B">varchar(20)</font></td></tr><tr><td align="left" port="class_code">FK class_code</td><td align="left"><font color="#6B5B4B">varchar(10)</font></td></tr><tr><td align="left" port="label">label</td><td align="left"><font color="#6B5B4B">varchar(80)</font></td></tr></table>>];
    "reference.municipalities" [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="3"><tr><td bgcolor="#E6DDC8" colspan="2" align="left"><b>municipalities</b></td></tr><tr><td align="left" port="municipality_code">PK <b>municipality_code</b></td><td align="left"><font color="#6B5B4B">varchar(10)</font></td></tr><tr><td align="left" port="municipality_name">municipality_name</td><td align="left"><font color="#6B5B4B">varchar(120)</font></td></tr><tr><td align="left" port="province">province</td><td align="left"><font color="#6B5B4B">varchar(60)</font></td></tr><tr><td align="left" port="category">category</td><td align="left"><font color="#6B5B4B">character(1)</font></td></tr></table>>];
    "reference.wards" [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="3"><tr><td bgcolor="#E6DDC8" colspan="2" align="left"><b>wards</b></td></tr><tr><td align="left" port="ward_id">PK <b>ward_id</b></td><td align="left"><font color="#6B5B4B">varchar(12)</font></td></tr><tr><td align="left" port="municipality_code">FK municipality_code</td><td align="left"><font color="#6B5B4B">varchar(10)</font></td></tr><tr><td align="left" port="ward_no">ward_no</td><td align="left"><font color="#6B5B4B">smallint</font></td></tr><tr><td align="left" port="in_study_area">in_study_area</td><td align="left"><font color="#6B5B4B">boolean</font></td></tr><tr><td align="left" port="demarcation_year">demarcation_year</td><td align="left"><font color="#6B5B4B">smallint</font></td></tr><tr><td align="left" port="source_code">FK source_code</td><td align="left"><font color="#6B5B4B">varchar(20)</font></td></tr><tr><td align="left" port="geom">geom</td><td align="left"><font color="#6B5B4B">geometry(MultiPolygon)</font></td></tr></table>>];
    "reference.work_order_priorities" [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="3"><tr><td bgcolor="#E6DDC8" colspan="2" align="left"><b>work_order_priorities</b></td></tr><tr><td align="left" port="priority_code">PK <b>priority_code</b></td><td align="left"><font color="#6B5B4B">varchar(2)</font></td></tr><tr><td align="left" port="label">label</td><td align="left"><font color="#6B5B4B">varchar(30)</font></td></tr><tr><td align="left" port="response_days">response_days</td><td align="left"><font color="#6B5B4B">smallint</font></td></tr></table>>];
  }
  subgraph cluster_assets { label=<<b>assets</b>>; fontsize=13; style="rounded"; color="#B9A383"; 
    "assets.electrical_assets" [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="3"><tr><td bgcolor="#DCE3CF" colspan="2" align="left"><b>electrical_assets</b></td></tr><tr><td align="left" port="asset_id">PK <b>asset_id</b></td><td align="left"><font color="#6B5B4B">bigint</font></td></tr><tr><td align="left" port="voltage_kv">voltage_kv</td><td align="left"><font color="#6B5B4B">numeric(6,2)</font></td></tr><tr><td align="left" port="rating_kva">rating_kva</td><td align="left"><font color="#6B5B4B">integer</font></td></tr></table>>];
    "assets.infrastructure_assets" [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="3"><tr><td bgcolor="#DCE3CF" colspan="2" align="left"><b>infrastructure_assets</b></td></tr><tr><td align="left" port="asset_id">PK <b>asset_id</b></td><td align="left"><font color="#6B5B4B">bigint</font></td></tr><tr><td align="left" port="asset_code">asset_code</td><td align="left"><font color="#6B5B4B">varchar(20)</font></td></tr><tr><td align="left" port="asset_name">asset_name</td><td align="left"><font color="#6B5B4B">varchar(150)</font></td></tr><tr><td align="left" port="type_code">FK type_code</td><td align="left"><font color="#6B5B4B">varchar(30)</font></td></tr><tr><td align="left" port="ward_id">FK ward_id</td><td align="left"><font color="#6B5B4B">varchar(12)</font></td></tr><tr><td align="left" port="status_code">FK status_code</td><td align="left"><font color="#6B5B4B">varchar(20)</font></td></tr><tr><td align="left" port="install_date">install_date</td><td align="left"><font color="#6B5B4B">date</font></td></tr><tr><td align="left" port="decommission_date">decommission_date</td><td align="left"><font color="#6B5B4B">date</font></td></tr><tr><td align="left" port="geometry_source_code">FK geometry_source_code</td><td align="left"><font color="#6B5B4B">varchar(20)</font></td></tr><tr><td align="left" port="attribute_source_code">FK attribute_source_code</td><td align="left"><font color="#6B5B4B">varchar(20)</font></td></tr><tr><td align="left" port="source_ref">source_ref</td><td align="left"><font color="#6B5B4B">varchar(60)</font></td></tr><tr><td align="left" port="geom">geom</td><td align="left"><font color="#6B5B4B">geometry(4326)</font></td></tr><tr><td align="left" port="created_at">created_at</td><td align="left"><font color="#6B5B4B">timestamptz</font></td></tr><tr><td align="left" port="created_by">created_by</td><td align="left"><font color="#6B5B4B">name</font></td></tr><tr><td align="left" port="updated_at">updated_at</td><td align="left"><font color="#6B5B4B">timestamptz</font></td></tr><tr><td align="left" port="updated_by">updated_by</td><td align="left"><font color="#6B5B4B">name</font></td></tr></table>>];
    "assets.public_facilities" [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="3"><tr><td bgcolor="#DCE3CF" colspan="2" align="left"><b>public_facilities</b></td></tr><tr><td align="left" port="asset_id">PK <b>asset_id</b></td><td align="left"><font color="#6B5B4B">bigint</font></td></tr><tr><td align="left" port="facility_use">facility_use</td><td align="left"><font color="#6B5B4B">varchar(60)</font></td></tr><tr><td align="left" port="operator">operator</td><td align="left"><font color="#6B5B4B">varchar(120)</font></td></tr><tr><td align="left" port="is_accessible">is_accessible</td><td align="left"><font color="#6B5B4B">boolean</font></td></tr><tr><td align="left" port="floor_area_m2">floor_area_m2</td><td align="left"><font color="#6B5B4B">numeric(10,1)</font></td></tr></table>>];
    "assets.road_segments" [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="3"><tr><td bgcolor="#DCE3CF" colspan="2" align="left"><b>road_segments</b></td></tr><tr><td align="left" port="asset_id">PK <b>asset_id</b></td><td align="left"><font color="#6B5B4B">bigint</font></td></tr><tr><td align="left" port="road_name">road_name</td><td align="left"><font color="#6B5B4B">varchar(120)</font></td></tr><tr><td align="left" port="road_class">road_class</td><td align="left"><font color="#6B5B4B">varchar(20)</font></td></tr><tr><td align="left" port="surface_type">surface_type</td><td align="left"><font color="#6B5B4B">varchar(20)</font></td></tr><tr><td align="left" port="lanes">lanes</td><td align="left"><font color="#6B5B4B">smallint</font></td></tr><tr><td align="left" port="width_m">width_m</td><td align="left"><font color="#6B5B4B">numeric(4,1)</font></td></tr><tr><td align="left" port="is_oneway">is_oneway</td><td align="left"><font color="#6B5B4B">boolean</font></td></tr></table>>];
    "assets.stormwater_assets" [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="3"><tr><td bgcolor="#DCE3CF" colspan="2" align="left"><b>stormwater_assets</b></td></tr><tr><td align="left" port="asset_id">PK <b>asset_id</b></td><td align="left"><font color="#6B5B4B">bigint</font></td></tr><tr><td align="left" port="structure">structure</td><td align="left"><font color="#6B5B4B">varchar(20)</font></td></tr><tr><td align="left" port="size_mm">size_mm</td><td align="left"><font color="#6B5B4B">smallint</font></td></tr><tr><td align="left" port="is_lined">is_lined</td><td align="left"><font color="#6B5B4B">boolean</font></td></tr></table>>];
    "assets.streetlights" [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="3"><tr><td bgcolor="#DCE3CF" colspan="2" align="left"><b>streetlights</b></td></tr><tr><td align="left" port="asset_id">PK <b>asset_id</b></td><td align="left"><font color="#6B5B4B">bigint</font></td></tr><tr><td align="left" port="lamp_type">lamp_type</td><td align="left"><font color="#6B5B4B">varchar(10)</font></td></tr><tr><td align="left" port="wattage_w">wattage_w</td><td align="left"><font color="#6B5B4B">smallint</font></td></tr><tr><td align="left" port="pole_height_m">pole_height_m</td><td align="left"><font color="#6B5B4B">numeric(4,1)</font></td></tr><tr><td align="left" port="pole_material">pole_material</td><td align="left"><font color="#6B5B4B">varchar(12)</font></td></tr></table>>];
